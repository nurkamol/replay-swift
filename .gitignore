.build/
build/
.DS_Store
*.xcuserstate

# Xcode's per-user state. The package opens in Xcode without a project file, and Xcode
# writes which schemes you have shown and in what order into here — it changes every time
# anyone switches scheme, and it is one person's preference on one machine. Shared schemes
# live in .swiftpm/xcode/xcshareddata/ instead, and those are committed on purpose.
.swiftpm/xcode/xcuserdata/
*.xcuserdatad/

# Xcode's build products, when it is the builder rather than SwiftPM.
DerivedData/

# Generated per machine by tools/xcode/install-schemes.sh — it names an absolute path,
# because Xcode's PathRunnable takes no relative one and SwiftPM defines no SRCROOT.
.swiftpm/xcode/xcshareddata/xcschemes/Replay (bundle).xcscheme

# `Replay.xcodeproj` is generated from project.yml but *is* committed, so that cloning and
# opening it is the whole setup. It contains no absolute paths — checked — and `project.yml`
# stays the source: edit that and re-run tools/xcode/install-schemes.sh. Editing the project
# in Xcode's own UI works until the next regenerate throws it away.
